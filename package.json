{
    "name": "youtube-automation",
    "description": "AutoTube Desktop Client",
    "author": "AutoTube",
    "private": true,
    "version": "1.0.4",
    "type": "module",
    "main": "main.js",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "oxlint",
        "preview": "vite preview",
        "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
        "package": "powershell -ExecutionPolicy Bypass -File build_backend.ps1 && vite build && electron-builder --win --x64 --publish never"
    },
    "build": {
        "appId": "com.autotube.app",
        "productName": "AutoTube",
        "directories": {
            "output": "C:/Users/DawoodMehmood/Desktop/AutoTubeBuild"
        },
        "files": [
            "dist/**/*",
            "main.js",
            "src/backend/**/*",
            "package.json",
            "node_modules/better-sqlite3/**/*",
            "node_modules/bindings/**/*",
            "node_modules/file-uri-to-path/**/*",
            "node_modules/node-addon-api/**/*",
            "node_modules/prebuild-install/**/*",
            "node_modules/yt-dlp-exec/**/*",
            "node_modules/ffmpeg-static/**/*",
            "node_modules/@google/genai/**/*",
            "node_modules/googleapis/**/*",
            "node_modules/googleapis-common/**/*",
            "node_modules/google-auth-library/**/*",
            "node_modules/gaxios/**/*",
            "node_modules/gcp-metadata/**/*",
            "node_modules/gtoken/**/*",
            "node_modules/jws/**/*",
            "node_modules/jwa/**/*",
            "node_modules/edge-tts-universal/**/*",
            "node_modules/google-tts-api/**/*",
            "node_modules/fluent-ffmpeg/**/*",
            "node_modules/electron-store/**/*"
        ],
        "asarUnpack": [
            "node_modules/better-sqlite3/**/*",
            "node_modules/ffmpeg-static/**/*",
            "node_modules/yt-dlp-exec/**/*"
        ],
        "win": {
            "target": "nsis",
            "signAndEditExecutable": false,
            "forceCodeSigning": false
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "extraResources": [
            {
                "filter": [
                    "**/*"
                ],
                "from": "python_clipper/dist/python_clipper",
                "to": "python_clipper"
            }
        ],
        "publish": [
            {
                "provider": "github",
                "owner": "95muhammadtalha-del",
                "repo": "Autotube-desktop"
            }
        ]
    },
    "dependencies": {
        "@distube/ytdl-core": "^4.16.12",
        "@google/genai": "^2.15.0",
        "better-sqlite3": "^13.0.3",
        "edge-tts-universal": "^1.4.0",
        "electron-is-dev": "^3.0.1",
        "electron-store": "^11.0.2",
        "electron-updater": "^6.8.9",
        "ffmpeg-static": "^5.3.0",
        "fluent-ffmpeg": "^2.1.3",
        "google-tts-api": "^2.0.2",
        "googleapis": "^173.0.0",
        "lucide-react": "^1.28.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "yt-dlp-exec": "^1.0.2"
    },
    "devDependencies": {
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "concurrently": "^10.0.4",
        "cross-env": "^10.1.0",
        "electron": "^43.2.0",
        "electron-builder": "^26.15.3",
        "oxlint": "^1.75.0",
        "vite": "^8.2.0",
        "wait-on": "^9.1.0"
    }
}
